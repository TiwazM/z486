function automatic logic x87_poly_pred(input logic [4:0] pred, input logic [1:0] quadrant,
                                       input logic cosine, input logic swap,
                                       input logic xneg, input logic yneg,
                                       input logic [1:0] id, input logic k0);
    case (pred)
        5'd0: return 1'b1; // ALWAYS
        5'd1: return quadrant == 2'd0; // Q0
        5'd2: return quadrant == 2'd1; // Q1
        5'd3: return quadrant == 2'd2; // Q2
        5'd4: return quadrant == 2'd3; // Q3
        5'd5: return quadrant == 2'd0 && !cosine; // Q0S
        5'd6: return quadrant == 2'd1 && !cosine; // Q1S
        5'd7: return quadrant == 2'd2 && !cosine; // Q2S
        5'd8: return quadrant == 2'd3 && !cosine; // Q3S
        5'd9: return quadrant == 2'd0 && cosine; // Q0C
        5'd10: return quadrant == 2'd1 && cosine; // Q1C
        5'd11: return quadrant == 2'd2 && cosine; // Q2C
        5'd12: return quadrant == 2'd3 && cosine; // Q3C
        5'd13: return swap; // SWAP
        5'd14: return !swap; // NOSWAP
        5'd15: return yneg; // YNEG
        5'd16: return !swap && !xneg; // QA
        5'd17: return swap && !xneg; // QB
        5'd18: return !swap && xneg; // QC
        5'd19: return swap && xneg; // QD
        5'd20: return !swap && !xneg && (id == 2'd0); // QA0
        5'd21: return !swap && !xneg && (id != 2'd0); // QA1
        5'd22: return !k0; // KNZ
        default: return 1'b0;
    endcase
endfunction
